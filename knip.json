{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        // Loaded by Claude Code from hooks/hooks.json.
        "hooks/register.ts",
        // The scripts the skill, the hooks and the worker run (`node SKILL/scripts/<name>.mjs`).
        "skills/tranchant/scripts/*.mjs",
        // The plugin's types, named by .claude-plugin/plugin.json.
        "types/index.d.ts",
        // The suites, not every file under test/.
        "test/**/*.test.mjs",
        "test/hooks.test.ts",
        // Builds the playground a real session tries the plugin on.
        "test/fixtures/playground.mjs"
      ],
      // The front-end fixture is another project's code, with planted defects: not ours to lint.
      "ignore": ["test/fixtures/front-end/**"],
      "node": false,
      // `typecheck` runs the TypeScript the workspace installs, hoisted to the root.
      "ignoreBinaries": ["tsc"],
      // claude-code and claude-code/testing: modules Claude Code provides to the hooks, not packages.
      "ignoreDependencies": ["claude-code"]
    },
    "skills/tranchant/page": {
      // Its Vitest suites (vitest.config.ts), not every file under test/.
      "node": false
    }
  }
}
